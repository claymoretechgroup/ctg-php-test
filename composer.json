{
    "name": "ctg/php-test",
    "version": "2.2.0",
    "description": "Pipeline-based test framework for PHP",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "CTG\\Test\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CTG\\Test\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    }
}
